check_basis_safety {
    basis_flat_idx {
        MemConfig = "pfaces_rw_global";
        HostDoWrite = "true";
    }
    next_state_table {
        MemConfig = "pfaces_rw_global";
        isNewOrResident = "false";
        residentFuncIdx = "0";
        residentFuncArgIdx = "0";
    }
    basis_list {
        MemConfig = "pfaces_rw_global";
        HostDoWrite = "true";
    }
    basis_list_size_ptr {
        MemConfig = "pfaces_rw_global";
        HostDoWrite = "true";
    }
    unsafe_flags {
        MemConfig = "pfaces_rw_global";
        directionWriteOrRead = "true";
        HostDoRead = "true";
    }
}
