precompute_transitions {
    next_state_table {
        MemConfig = "pfaces_rw_global";
        directionWriteOrRead = "true";
        HostDoWrite = "true";
        HostDoRead = "true";
        baseTypeSize = "8";
    }
    runtime_params {
        MemConfig = "pfaces_rw_global";
        HostDoWrite = "true";
    }
}
