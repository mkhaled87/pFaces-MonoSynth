{
  "version": 1,
  "name": "acc-large-membership-crossover-poc",
  "configs": [
    "examples/acc/acc.cfg"
  ],
  "methods": [
    "automatica_scan",
    "automatica_threshold",
    "threshold_cpu_reference",
    "threshold"
  ],
  "state_eta": "0.25,0.125,0.125",
  "warmup_runs": 0,
  "measured_runs": 1,
  "device": "1",
  "timeout_seconds": 300,
  "verbose": 1,
  "output": "tools/benchmark_results/large_acc_poc",
  "config_overrides": {
    "max_basis_elements": 50000
  },
  "allow_nonmonotone_diagnostic": false
}
