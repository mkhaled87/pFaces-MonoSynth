{
    "cfg_file": "../../examples/turn_ego_first/turn_ego_first.cfg",

    "synthesis": {
        "mode": "direct",
        "kernel_pack": "../../kernel-pack",
        "device_id": 0
    },

    "controller": {
        "prediction_horizon": 10,
        "control_horizon": 10,
        "ode_substeps": 20,
        "mppi_rollouts": 512,
        "mppi_sigma": 1000.0,
        "mppi_iterations": 10,
        "cost": {
            "w_progress": 1.0,
            "w_safety": 10000.0,
            "w_terminal_v": 10.0,
            "w_jerk": 0.000001,
            "goal": 10.0,
            "unsafe_goal": -8.0
        }
    },

    "simulation": {
        "x0": [-35.0, 12.0, -50.0],
        "duration": 6.0,
        "sampling_period": 0.1,
        "resynth_threshold": 1.0,
        "resynth_policy": "always"
    },

    "sensor": {
        "type": "sine",
        "value": 8.0,
        "amplitude": 3.0,
        "frequency": 0.15
    },

    "verbose": true
}
