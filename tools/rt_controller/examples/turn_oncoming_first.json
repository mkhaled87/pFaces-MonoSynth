{
    "cfg_file": "../../examples/turn_oncoming_first/turn_oncoming_first.cfg",

    "synthesis": {
        "mode": "direct",
        "kernel_pack": "../../kernel-pack",
        "device_id": 0
    },

    "controller": {
        "prediction_horizon": 10,
        "control_horizon": 10,
        "ode_substeps": 20,
        "mppi_rollouts": 512,
        "mppi_sigma": 1000.0,
        "mppi_iterations": 10,
        "cost": {
            "w_progress": 1.0,
            "w_safety": 10000.0,
            "w_terminal_v": 10.0,
            "w_jerk": 0.000001,
            "goal": -8.0,
            "unsafe_goal": 10.0
        }
    },

    "simulation": {
        "x0": [-30.0, 2.0, -50.0],
        "duration": 6.0,
        "sampling_period": 0.1,
        "resynth_threshold": 0.5,
        "resynth_policy": "always"
    },

    "sensor": {
        "type": "const",
        "value": 0.0
    },

    "verbose": true
}
