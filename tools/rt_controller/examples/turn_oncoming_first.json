{
    "cfg_file": "../../pFaces-MonoSynth/examples/turn_oncoming_first/turn_oncoming_first.cfg",

    "synthesis": {
        "mode": "direct",
        "kernel_pack": "../../kernel-pack",
        "device_id": 0
    },

    "controller": {
        "prediction_horizon": 10,
        "control_horizon": 10,
        "ode_substeps": 50,
        "mppi_rollouts": 512,
        "mppi_sigma": 1000.0,
        "cost": {
            "w_progress": 1.0,
            "w_safety": 10000.0,
            "w_terminal_v": 10.0,
            "w_jerk": 0.001,
            "goal": -10.0,
            "unsafe_goal": -40.0
        }
    },

    "simulation": {
        "x0": [-40.0, 0.0, -50.0],
        "duration": 15.0,
        "sampling_period": 0.5,
        "resynth_threshold": 0.5,
        "resynth_policy": "threshold"
    },

    "sensor": {
        "type": "const",
        "value": 8.0
    },

    "verbose": true
}
