{
    "cfg_file": "../../examples/two_oncoming/two_oncoming.cfg",
    "dynamics_class": "two_oncoming",

    "synthesis_go": {
        "cfg_file": "../../examples/turn_ego_first/turn_ego_first.cfg",
        "mode": "direct",
        "kernel_pack": "../../kernel-pack",
        "device_id": 0
    },
    "synthesis_wait": {
        "cfg_file": "../../examples/turn_oncoming_first/turn_oncoming_first.cfg",
        "mode": "direct",
        "kernel_pack": "../../kernel-pack",
        "device_id": 0
    },

    "controller": {
        "prediction_horizon": 10,
        "control_horizon": 10,
        "mppi_rollouts": 512,
        "mppi_sigma": 1000.0,
        "mppi_iterations": 10,
        "cost": {
            "w_progress": 1.0,
            "w_safety": 10000.0,
            "w_terminal_v": 1,
            "w_jerk": 0.0001,
            "goal": 10.0,
            "unsafe_goal": -10.0
        }
    },

    "simulation": {
        "x0": [-20.0, 4.0, -15.0, -40.0],
        "duration": 8.0,
        "sampling_period": 0.1,
        "resynth_policy": "threshold",
        "resynth_threshold": 0.25
    },

    "sensor":   { "type": "sine", "value": 10.0, "amplitude": -3.0, "frequency": 0.05 },
    "sensor_2": { "type": "sine", "value": 4, "amplitude": 4, "frequency": 0.04 },

    "verbose": true
}
